{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growthhub",
  "account_id": "a882aa8318c5c4e6265d0511fe34679a",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"growthhub.dev","custom_domain":true}],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://growthhub.dev",
    "INVITE_ONLY": "true",
    "AUTH_PROVIDERS": "google",
    "MAINTENANCE": "true"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "growthhub-production",
    "database_id": "294e8d50-fb49-4696-83a4-95012e624bd9",
    "migrations_dir": "drizzle"
  }]
}
