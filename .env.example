# Configuration worksheet, not an active production environment.
# The local preview intentionally uses isolated fixture identities.
# Configure production values using Sites environment variables.
INVITE_ONLY=true
ADMIN_EMAILS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Enable only after the corresponding provider is configured and tested.
AUTH_PROVIDERS=google
# Google secrets and SMTP credentials belong in Supabase, not this repo.
# Apple sign-in is deferred and has no visible entry point.
