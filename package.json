{
  "name": "growthhub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/verify-release.mjs",
    "check:recovery": "node scripts/verify-recovery.mjs",
    "db:generate": "drizzle-kit generate",
    "dev:cloudflare": "wrangler dev --local --port 8788 --var PUBLIC_ORIGIN:http://growthhub.dev --var MAINTENANCE:false",
    "check:cloudflare": "node scripts/check-deploy.mjs && wrangler deploy --dry-run --outdir dist/cloudflare",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy"
  },
  "devDependencies": {
    "@primer/primitives": "^11.10.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "wrangler": "^4.149.0"
  }
}
